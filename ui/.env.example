# Основной конфиг modbusua
MODBUSUA_CONFIG=D:\downloads\modbusua_0.4.1\conf\modbusua.conf

# Исполняемый файл modbusua для кнопок Запустить/Остановить/Перезапустить
MODBUSUA_EXECUTABLE=D:\downloads\modbusua_0.4.1\bin\modbusua.exe
MODBUSUA_WORKDIR=D:\downloads\modbusua_0.4.1
MODBUSUA_RUN_MODE=process
MODBUSUA_SERVICE_NAME=modbusua

# OPC UA самого modbusua
MODBUSUA_OPCUA_ENDPOINT=opc.tcp://127.0.0.1:4840
MODBUSUA_OPCUA_NAMESPACE_INDEX=2
MODBUSUA_OPCUA_APP_NAME=modbusua

# Авторизация UI. Регистрации нет.
MODBUSUA_UI_PASSWORD=ЗАДАЙ_СВОЙ_ПАРОЛЬ
MODBUSUA_UI_SECRET=ЗАДАЙ_ДЛИННУЮ_СЕКРЕТНУЮ_СТРОКУ
MODBUSUA_UI_SESSION_DAYS=7
MODBUSUA_UI_HOST=127.0.0.1
MODBUSUA_UI_PORT=8088
