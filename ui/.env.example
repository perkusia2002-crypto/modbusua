# Пароль входа в инженерный UI
MODBUSUA_UI_PASSWORD=
MODBUSUA_UI_SECRET=
MODBUSUA_UI_SESSION_DAYS=7

# OPC UA gateway
MODBUSUA_OPCUA_ENDPOINT=opc.tcp://127.0.0.1:4840
MODBUSUA_OPCUA_NAMESPACE_INDEX=2
MODBUSUA_OPCUA_APP_NAME=modbusua

# HTTP UI
MODBUSUA_UI_HOST=127.0.0.1
MODBUSUA_UI_PORT=8088

# Обычно менять не нужно: конфиг, exe и рабочая папка
# автоматически определяются относительно этой папки.
